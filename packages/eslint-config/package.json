{
  "name": "@worklume/eslint-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared ESLint flat configs for Worklume TypeScript and React code.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./base.js",
    "./react": "./react.js"
  },
  "files": [
    "base.js",
    "react.js"
  ],
  "scripts": {
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "typescript-eslint": "8.70.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@worklume/tsconfig": "workspace:*",
    "eslint": "10.11.0",
    "typescript": "6.0.3"
  }
}
