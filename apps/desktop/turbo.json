{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "lint": {
      "dependsOn": ["^build", "build"],
      "passThroughEnv": [
        "CARGO_HOME",
        "RUSTUP_HOME",
        "RUSTUP_TOOLCHAIN",
        "CARGO_TARGET_DIR",
        "PKG_CONFIG_PATH"
      ]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/api-contract/test/fixtures/desktop-events.json",
        "$TURBO_ROOT$/packages/api-contract/test/fixtures/desktop-capabilities.json"
      ],
      "outputs": [],
      "passThroughEnv": [
        "CARGO_HOME",
        "RUSTUP_HOME",
        "RUSTUP_TOOLCHAIN",
        "CARGO_TARGET_DIR",
        "PKG_CONFIG_PATH"
      ]
    }
  }
}
