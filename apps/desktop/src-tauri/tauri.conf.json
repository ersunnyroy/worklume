{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Worklume",
  "identifier": "com.worklume.agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:frontend",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Worklume",
        "width": 420,
        "height": 560,
        "resizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Worklume time tracking agent",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/etc/xdg/autostart/com.worklume.agent.desktop": "linux/com.worklume.agent.autostart.desktop",
          "/usr/share/gnome-shell/extensions/active-window@worklume.com/metadata.json": "linux/gnome-extension/active-window@worklume.com/metadata.json",
          "/usr/share/gnome-shell/extensions/active-window@worklume.com/extension.js": "linux/gnome-extension/active-window@worklume.com/extension.js"
        }
      },
      "rpm": {
        "files": {
          "/etc/xdg/autostart/com.worklume.agent.desktop": "linux/com.worklume.agent.autostart.desktop",
          "/usr/share/gnome-shell/extensions/active-window@worklume.com/metadata.json": "linux/gnome-extension/active-window@worklume.com/metadata.json",
          "/usr/share/gnome-shell/extensions/active-window@worklume.com/extension.js": "linux/gnome-extension/active-window@worklume.com/extension.js"
        }
      }
    }
  }
}
